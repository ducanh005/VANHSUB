# ==========================================================================
# VANHSUB — biến môi trường cho script test (KHÔNG dùng bởi app chính)
#
# App chính KHÔNG đọc sessionid từ .env: session được nhập trong Cài đặt
# và lưu MÃ HOÁ bằng safeStorage (DPAPI) trong userData.
#
# File .env chỉ dùng cho script test dòng lệnh:
#   npx tsx scripts/test-tiktok-tts.ts "Xin chào" BV074_streaming
#
# ⚠️  KHÔNG BAO GIỜ đặt sessionid thật vào file này hoặc file .env và commit.
#     .env đã nằm trong .gitignore — giữ nguyên như vậy.
# ==========================================================================

# Copy giá trị cookie "sessionid" từ tiktok.com (session của CHÍNH BẠN) vào đây
# khi chạy test — biến chỉ tồn tại trong tiến trình test, không được ghi xuống đĩa.
TIKTOK_SESSIONID=
